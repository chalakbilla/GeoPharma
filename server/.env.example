# Neon Postgres connection string
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Random long string, e.g. `openssl rand -hex 32`
JWT_SECRET=replace-with-a-long-random-string

# Google Cloud project that has Vertex AI enabled
GOOGLE_PROJECT_ID=your-gcp-project-id
GOOGLE_LOCATION=us-central1

# Paste the FULL contents of your service account JSON key as a single line here.
# Never commit the actual key file — this is the only place it should live.
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...", ...}

# Server-side only — never expose this to the client
DRUG_DB_API_KEY=replace-with-your-drug-database-key

PORT=5000
